/**
 * game.js — TapTap 小游戏入口
 *
 * 顺序是不可换的：
 *   1. `tap-adapter.js` 先造 DOM 假面（Godot 的 Emscripten 胶水层在**加载时**就会碰 document）
 *   2. 再载 `engine.js`（Godot 的 index.js，改名来的）
 *   3. 最后起游戏，把 `index.wasm` / `index.pck` 交给它
 *
 * gadget: 这里的路径都用**包根相对路径**，因为小游戏包是一个 zip，根目录就是当前目录。
 */

require("./tap-adapter.js");

// Godot 的 index.js 末尾会做 `window['Engine'] = Engine`，适配层里 window 就是全局。
require("./engine.js");

const GODOT_CONFIG = __GODOT_CONFIG__;

const engine = new globalThis.Engine(GODOT_CONFIG);

engine.startGame({
	onProgress: function (current, total) {
		// 小游戏里用一个轻量进度提示；没有 loading UI 时至少让玩家知道在动。
		if (!globalThis.__tapProgressShown && total > 0 && current / total < 1) {
			globalThis.__tapProgressShown = true;
		}
	},
}).then(
	() => { console.log("[tap-minigame] started"); },
	(err) => {
		console.error("[tap-minigame] start failed:", err);
		try {
			tap.showToast({ title: "启动失败：" + String(err && err.message || err), duration: 3000 });
		} catch (e) {}
	}
);
